{
  "defaultProvider": "codex",
  "workspaceRoot": "/Users/shatilov/Work/assyst-daemon",
  "agents": {
    "codex": {
      "type": "codex",
      "bin": "codex",
      "sandbox": "workspace-write",
      "approvalPolicy": "never",
      "extraArgs": ["--skip-git-repo-check"]
