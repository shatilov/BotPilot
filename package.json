{
  "name": "botpilot",
  "version": "0.1.0",
  "description": "Control your computer through a bot-powered local agent.",
  "main": "dist/electron/main.js",
  "bin": {
    "botpilot": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "master": "tsx src/cli.ts master",
    "package": "npm run build && electron-builder --mac dmg",
    "package:dir": "npm run build && electron-builder --dir",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "build": {
    "appId": "local.botpilot.daemon",
    "productName": "BotPilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "README.md",
      "configs/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/mcp/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "keywords": [
    "agent",
    "daemon",
    "electron",
    "codex",
    "claude"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.2"
  }
}
